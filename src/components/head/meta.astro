---
import { SEO } from "astro-seo";
import { merge } from "es-toolkit";

import { getSingleton } from "@/lib/content";

import { getOpenGraphProps, getPreloadLinks, getTwitterProps } from "./utils";
import type { Preload, SEOData } from "./types";

export interface Props extends Partial<Omit<SEOData, "siteName">> {
  preload?: Preload[];
  titleTemplate?: string;
}

const { titleTemplate, preload = [], ...props } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const seo = await getSingleton("seo");
const data = merge(seo.data, props ?? {});
---

<meta charset="UTF-8" />

<SEO
  titleTemplate={titleTemplate}
  title={data.title}
  description={data.description}
  canonical={canonicalURL.href}
  openGraph={getOpenGraphProps(data, Astro.url)}
  twitter={getTwitterProps(data)}
  extend={{
    link: [
      ...getPreloadLinks(preload),
      { rel: "sitemap", href: "/sitemap-index.xml" },
    ],
    meta: [{ name: "viewport", content: "width=device-width,initial-scale=1" }],
  }}
/>
